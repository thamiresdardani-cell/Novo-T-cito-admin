-- 1. NOTIFICAÇÃO NA TELA (PARA SABER SE CHEGOU)
----------------------------------------------------
local function ShowNotif(msg)
	local sg = LocalPlayer:WaitForChild("PlayerGui"):FindFirstChild("TacitoNotifs")
	if not sg then
		sg = Instance.new("ScreenGui")
		sg.Name = "TacitoNotifs"
		sg.ResetOnSpawn = false
		sg.Parent = LocalPlayer:WaitForChild("PlayerGui")
	end
	
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(0, 220, 0, 45)
	frame.Position = UDim2.new(1, -230, 0.75, 0)
	frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	frame.BorderSizePixel = 0
	frame.Parent = sg
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = frame
	
	local txt = Instance.new("TextLabel")
	txt.Size = UDim2.new(1, -10, 1, 0)
	txt.Position = UDim2.new(0, 5, 0, 0)
	txt.BackgroundTransparency = 1
	txt.Text = msg
	txt.TextColor3 = Color3.fromRGB(255, 255, 255)
	txt.Font = Enum.Font.SourceSansBold
	txt.TextSize = 14
	txt.TextWrapped = true
	txt.Parent = frame
	
	task.delay(3, function() frame:Destroy() end)
end

----------------------------------------------------
-- 2. ENVIO DE MENSAGENS SENSÍVEIS (CHAT SAFE)
----------------------------------------------------
local function SendChatMessage(msg)
	pcall(function()
		if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
			local channel = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
			if channel then channel:SendAsync(msg) end
		else
			local defaultChat = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
			if defaultChat and defaultChat:FindFirstChild("SayMessageRequest") then
				defaultChat.SayMessageRequest:FireServer(msg, "All")
			end
		end
	end)
end

----------------------------------------------------
-- 3. EXECUÇÃO LOCAL (AÇÕES NO PRÓPRIO AVATAR)
----------------------------------------------------
local function RunAction(cmd, senderName)
	local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 2)
	local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 2)

	if not hrp or not hum then return end

	ShowNotif("Tácito: Executando " .. string.upper(cmd))

	if cmd == "kick" then
		LocalPlayer:Kick("Você foi kickado via Tácito Hub!")

	elseif cmd == "kill" then
		hum.Health = 0

	elseif cmd == "killplus" then
		hum.Health = 0
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = "rbxassetid://243664672"
		pe.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 0)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(0, 0, 255))
		})
		pe.Size = NumberSequence.new(3)
		pe.Speed = NumberRange.new(20, 35)
		pe.Lifetime = NumberRange.new(1, 2)
		pe.Parent = hrp
		task.delay(2, function() pe:Destroy() end)

	elseif cmd == "jail" then
		if ActiveJail then ActiveJail:Destroy() end
		local j = Instance.new("Part")
		j.Name = "TacitoJailPart"
		j.Size = Vector3.new(8, 10, 8)
		j.CFrame = hrp.CFrame
		j.Anchored = true
		j.Transparency = 0.5
		j.Color = Color3.fromRGB(0, 150, 255)
		j.Material = Enum.Material.Forcefield
		j.CanCollide = true
		j.Parent = workspace
		
		hrp.CFrame = j.CFrame
		ActiveJail = j

	elseif cmd == "unjail" then
		if ActiveJail then
			ActiveJail:Destroy()
			ActiveJail = nil
		end

	elseif cmd == "bring" then
		local sender = Players:FindFirstChild(senderName)
		if sender and sender.Character and sender.Character:FindFirstChild("HumanoidRootPart") then
			hrp.CFrame = sender.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
		end

	elseif cmd == "freeze" then
		if FreezeConnection then FreezeConnection:Disconnect() end
		local pos = hrp.CFrame
		FreezeConnection = RunService.Heartbeat:Connect(function()
			if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
				LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(pos.Position) * LocalPlayer.Character.HumanoidRootPart.CFrame.Rotation
			end
		end)

	elseif cmd == "unfreeze" then
		if FreezeConnection then
			FreezeConnection:Disconnect()
			FreezeConnection = nil
		end

	elseif cmd == "explode" then
		local exp = Instance.new("Explosion")
		exp.Position = hrp.Position
		exp.Parent = workspace
		hum.Health = 0
	end
end

----------------------------------------------------
-- 4. PROCESSAMENTO DAS MENSAGENS
----------------------------------------------------
local function IncomingMessage(senderName, text)
	if not text or string.sub(text, 1, 1) ~= ";" then return end
	
	local clean = string.sub(text, 2)
	local parts = string.split(clean, " ")
	local cmd = string.lower(parts[1] or "")
	local target = parts[2] or ""

	if cmd == "verifique" then
		SendChatMessage("tácito_" .. string.format("%04d", math.random(1000, 9999)))
		return
	end

	-- Verifica se a mensagem é para você (Username ou DisplayName)
	local myName = string.lower(LocalPlayer.Name)
	local myDisplay = string.lower(LocalPlayer.DisplayName)
	local targetLower = string.lower(target)

	if targetLower == myName or targetLower == myDisplay then
		RunAction(cmd, senderName)
	end
end

-- Escutador Universal de Chat
pcall(function()
	TextChatService.MessageReceived:Connect(function(message)
		if message.TextSource then
			local sender = Players:GetPlayerByUserId(message.TextSource.UserId)
			if sender then IncomingMessage(sender.Name, message.Text) end
		end
	end)
end)

Players.PlayerAdded:Connect(function(p)
	p.Chatted:Connect(function(msg) IncomingMessage(p.Name, msg) end)
end)
for _, p in ipairs(Players:GetPlayers()) do
	p.Chatted:Connect(function(msg) IncomingMessage(p.Name, msg) end)
end

